name: lorekeeper-sync

x-logging: &logging
  driver: json-file
  options: {max-size: 10m, max-file: "3"}

services:
  # Publishes no port: ufw does not filter Docker-published ports, so the only
  # way in is cloudflared. Not behind Cloudflare Access, unlike Foundry: the
  # desktop apps connect directly, and the server authenticates each room by
  # its token itself.
  lorekeeper-sync:
    # TODO: pin a digest once the first image is published, as
    # `:latest@sha256:<digest>`, the form Renovate's regex manager matches; it
    # then follows latest's digest. Until then Compose pulls latest once and
    # never refreshes it.
    image: ghcr.io/yonatankarp/lorekeeper-sync:latest
    restart: unless-stopped
    logging: *logging
    # The image's own non-root user, pinned here so it always owns /data.
    user: "{{ lorekeeper_sync_uid }}:{{ lorekeeper_sync_gid }}"
    read_only: true
    tmpfs:
      - /tmp:mode=1777
    security_opt: [no-new-privileges:true]
    volumes:
      - /srv/lorekeeper-sync/data:/data
    environment:
      LOREKEEPER_SYNC_DB: /data/sync.db
      LOREKEEPER_SYNC_ADDR: 0.0.0.0:8080
      LOREKEEPER_SYNC_PUBLIC_URL: https://{{ lorekeeper_sync_hostname }}
      # Rate limits key on CF-Connecting-IP, which cloudflared passes through.
      LOREKEEPER_SYNC_TRUST_PROXY: cloudflare
    # GET /healthz through the binary itself, as the image has no curl or wget.
    # It must match the image: without --healthcheck the container never turns
    # healthy and the deploy's wait fails the converge.
    healthcheck:
      test: [CMD, /usr/local/bin/lorekeeper-sync, --healthcheck]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s

  # Its own tunnel, lorekeeper-sync, not Foundry's. Remote-managed: the public
  # hostname (lorekeeper.yonatankarp.com -> http://localhost:8080) is set in
  # the Cloudflare dashboard, not here.
  cloudflared:
    image: cloudflare/cloudflared:2026.9.3@sha256:072c067d25ccbe61d46e18f0d0723255f2bb5304f7317caa95b27031520ff92c
    restart: unless-stopped
    logging: *logging
    # The same check as Foundry's cloudflared (see its compose for why).
    command: tunnel --no-autoupdate --metrics 127.0.0.1:20241 run
    healthcheck:
      test: [CMD, cloudflared, tunnel, --metrics, "127.0.0.1:20241", ready]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    # Shares the server's network namespace, so localhost:8080 is the server.
    network_mode: service:lorekeeper-sync
    depends_on: [lorekeeper-sync]
    environment:
      TUNNEL_TOKEN: ${TUNNEL_TOKEN:?}
