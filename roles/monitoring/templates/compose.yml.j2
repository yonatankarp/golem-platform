name: monitoring

x-logging: &logging
  driver: json-file
  options: {max-size: 10m, max-file: "3"}

services:
  # Dials the NAS's Beszel hub outbound and registers itself with the hub's
  # universal token, so nothing on the NAS has to be told about golem first.
  agent:
    image: ghcr.io/henrygd/beszel/beszel-agent:0.20.0@sha256:2c3b2d781a8bcdb464704c0024baab5486d238d40871b67c84d906d34791c490
    restart: unless-stopped
    logging: *logging
    depends_on:
      socket-proxy:
        condition: service_healthy
    networks: [default, docker-api]
    volumes:
      # Holds the agent's fingerprint; losing it registers golem a second time.
      - /srv/monitoring/beszel-agent:/var/lib/beszel-agent
    env_file: .env
    environment:
      DISABLE_SSH: "true"
      DOCKER_HOST: tcp://socket-proxy:2375
      HUB_URL: {{ beszel_hub_url }}
      SYSTEM_NAME: golem

  # CONTAINERS serves /containers/{id}/json, which includes every container's
  # environment -- the tunnel token among them. So this proxy sits on an
  # internal network shared with the agent alone and publishes nothing (NAS #829).
  socket-proxy:
    image: lscr.io/linuxserver/socket-proxy:3.4.5@sha256:ca6c0301a652232d02cb0ff9f1c5d20d9b339f391e1c1dffaae6ef3bfc59d009
    restart: unless-stopped
    logging: *logging
    networks: [docker-api]
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    environment:
      CONTAINERS: "1"
      EVENTS: "0"
      POST: "0"
    healthcheck:
      test: [CMD-SHELL, "wget -q -O - http://127.0.0.1:2375/_ping | grep -qx OK"]
      interval: 10s
      timeout: 3s
      retries: 3

  # Dialled by the NAS's Dozzle to show golem's container logs. Both ends present
  # and trust the platform's own pair; the image's built-in pair is public, and
  # Dozzle falls back to it silently if DOZZLE_CERT names no file. The hub pushes
  # its alert rules and webhook (with the NAS relay's bearer token) here, and the
  # agent saves them to /data/notifications.yml and reloads them at start. The
  # hub re-sends them only when it restarts or a rule changes, never when an
  # agent comes back (Dozzle v11.1.2 retriable_client_manager.go), so /data is
  # persistent: a tmpfs here lost every rule on each recreate (seen 2026-09-28).
  # The price is the relay's bearer token on golem's disk, root-only.
  # The pin matches the NAS's Dozzle: hub and agent are bumped together.
  #
  # The agent dispatches those alerts itself, to the URL the hub pushed:
  # http://alert-relay:<port>/alerts. extra_hosts points that name at the NAS's
  # tailnet address, where a Tailscale Serve TCP forward reaches the NAS's alert
  # relay, so the pushed URL works unchanged. DOZZLE_HOSTNAME is the host name
  # the agent stamps on every event; the NAS relay pages events from host
  # `golem` on the Golem Pushover app, so it must stay exactly that.
  dozzle-agent:
    image: docker.io/amir20/dozzle:v11.1.2@sha256:55204b375a03c92310d79b659b66217bd38f5675b361e2b5e7b4a03139bbb077
    restart: unless-stopped
    logging: *logging
    command: [agent]
    user: "65534:65534"
    read_only: true
    tmpfs:
      - /tmp:mode=1777
    security_opt: [no-new-privileges:true]
    depends_on:
      dozzle-socket-proxy:
        condition: service_healthy
    # default is not internal: it is the route to the NAS's tailnet address.
    networks: [default, dozzle-docker-api]
    extra_hosts:
      - "alert-relay:{{ nas_tailnet_address }}"
    ports:
      - "{{ dozzle_agent_address }}:7007"
    labels:
      golem.dozzle-agent.certificate-sha256: "{{ vault_dozzle_agent_certificate | hash('sha256') }}"
    volumes:
      - /srv/monitoring/dozzle-agent/data:/data
      - /srv/monitoring/dozzle-agent/cert.pem:/certs/cert.pem:ro
      - /srv/monitoring/dozzle-agent/key.pem:/certs/key.pem:ro
    environment:
      DOCKER_HOST: tcp://dozzle-socket-proxy:2375
      DOZZLE_CERT: /certs/cert.pem
      DOZZLE_HOSTNAME: golem
      DOZZLE_KEY: /certs/key.pem
      DOZZLE_NO_ANALYTICS: "true"
    healthcheck:
      test: [CMD, /dozzle, healthcheck]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s

  # Dozzle needs events and logs, which the Beszel agent's proxy denies, so it
  # gets its own rather than widening what the Beszel agent can read. Like that
  # one it sits on an internal network shared with its agent alone.
  dozzle-socket-proxy:
    image: lscr.io/linuxserver/socket-proxy:3.4.5@sha256:ca6c0301a652232d02cb0ff9f1c5d20d9b339f391e1c1dffaae6ef3bfc59d009
    restart: unless-stopped
    logging: *logging
    networks: [dozzle-docker-api]
    read_only: true
    tmpfs: [/run]
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    environment:
      ALLOW_LOGS: "1"
      CONTAINERS: "1"
      EVENTS: "1"
      INFO: "1"
      POST: "0"
    healthcheck:
      test: [CMD-SHELL, "wget -q -O - http://127.0.0.1:2375/_ping | grep -qx OK"]
      interval: 10s
      timeout: 3s
      retries: 3

networks:
  docker-api:
    internal: true
  dozzle-docker-api:
    internal: true
