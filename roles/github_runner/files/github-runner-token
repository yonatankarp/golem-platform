#!/bin/sh
# Run as root before each runner container starts (ExecStartPre=+): turns the
# root-only PAT into a one-hour registration token, so the PAT never enters a
# container or a file the runner user can read.
set -eu
slug="$1"
target="$(cat "/etc/github-runner/$slug.target")"
owner="${target%%/*}"
case "$target" in
  */*) api="repos/$target" ;;
  *) api="orgs/$target" ;;
esac
token="$(curl -fsS -X POST \
  -H "Authorization: Bearer $(cat "/etc/github-runner/pat-$owner")" \
  -H "Accept: application/vnd.github+json" \
  -H "X-GitHub-Api-Version: 2022-11-28" \
  "https://api.github.com/$api/actions/runners/registration-token" | jq -er .token)"
env="/run/github-runner/$slug/env"
umask 077
printf 'RUNNER_URL=https://github.com/%s\nRUNNER_TOKEN=%s\n' "$target" "$token" > "$env"
chown "$2" "$env"
