name: foundry

x-logging: &logging
  driver: json-file
  options: {max-size: 10m, max-file: "3"}

# Files, not environment variables: every container's environment is served by
# the monitoring stack's Docker socket proxies (CONTAINERS=1).
secrets:
  foundry:
    file: /srv/foundry/config.json
  tunnel-token:
    file: /srv/foundry/tunnel-token

services:
  # Publishes no port: ufw does not filter Docker-published ports, so the only
  # way in is cloudflared, behind Cloudflare Access.
  foundry:
    image: felddy/foundryvtt:14.368.0@sha256:8ec86078b0c461644d896cbe3a9f9bcae7d1ce8dc8d91eeb0b0f1d94c91c072f
    restart: unless-stopped
    logging: *logging
    stop_grace_period: 30s
    networks: [egress]
    # The image starts as node and never calls su, sudo or mount, so it needs no
    # capability. The rootfs stays writable: the entrypoint unpacks the release
    # into /home/node/resources in every new container.
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    # A mounted file, unlike the environment, does not recreate the container
    # when it changes; this label does. The tunnel token salts it, so the label,
    # which the socket proxies serve too, is no offline check for a short password.
    labels:
      golem.foundry.credentials-sha256: "{{ [vault_cloudflare_tunnel_token, vault_foundry_username, vault_foundry_password, vault_foundry_admin_key] | to_json | hash('sha256') }}"
    # The entrypoint reads exactly this path, and without it still starts
    # healthy, only with no admin key on /setup.
    secrets:
      - {source: foundry, target: /run/secrets/config.json}
    volumes:
      - /srv/foundry/data:/data
    environment:
      CONTAINER_CACHE: /data/container_cache
      FOUNDRY_HOSTNAME: {{ foundry_hostname }}
      FOUNDRY_PROXY_PORT: "443"
      FOUNDRY_PROXY_SSL: "true"
      FOUNDRY_TELEMETRY: "false"

  cloudflared:
    image: cloudflare/cloudflared:2026.9.3@sha256:072c067d25ccbe61d46e18f0d0723255f2bb5304f7317caa95b27031520ff92c
    restart: unless-stopped
    logging: *logging
    # Runs as nonroot and only dials out; it writes nothing to its rootfs.
    read_only: true
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    # The image has no shell or wget, so the check is cloudflared's own `tunnel
    # ready`: 200 from /ready once at least one edge connection is up. It
    # refuses to run without --metrics, so the address is pinned in both places,
    # on Foundry's loopback, which this container shares.
    command: tunnel --no-autoupdate --metrics 127.0.0.1:20241 run
    healthcheck:
      test: [CMD, cloudflared, tunnel, --metrics, "127.0.0.1:20241", ready]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    # Shares Foundry's network namespace, so the tunnel's existing dashboard
    # route (dnd.yonatankarp.com -> http://localhost:30000) reaches it unchanged.
    # Only the network: the token is mounted here alone, out of Foundry's reach.
    network_mode: service:foundry
    depends_on: [foundry]
    # Recreates the container on a new token, as Foundry's label does.
    labels:
      golem.cloudflared.token-sha256: "{{ vault_cloudflare_tunnel_token | hash('sha256') }}"
    secrets: [tunnel-token]
    environment:
      TUNNEL_TOKEN_FILE: /run/secrets/tunnel-token

# On a fixed subnet, which hardening's golem-foundry-egress keeps off the LAN,
# the tailnet and Docker's networks. A new network rather than a subnet on
# `default`: Compose 5.6.0 recreates a changed network by stopping and
# reconnecting Foundry alone, which would leave cloudflared in Foundry's old
# namespace. A new network changes Foundry's own config, so Compose recreates
# it, and cloudflared with it. The old foundry_default is left behind, unused.
networks:
  egress:
    ipam:
      config:
        - subnet: {{ foundry_subnet }}
